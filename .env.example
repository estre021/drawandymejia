# PayPal REST app credentials. Keep the secret only on the server.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal currently processes this checkout in USD. Set the approved USD equivalent
# for the RD$4,200 consultation after confirming the exchange rate and account setup.
PAYMENT_CURRENCY=USD
PAYMENT_AMOUNT=

# Public URL used by PayPal and email links.
APP_BASE_URL=http://localhost:8000
PORT=8000

# SMTP account used to send receipts to the patient and the doctor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
DOCTOR_EMAIL=drawandymejiard@gmail.com
